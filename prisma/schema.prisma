// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  isAdmin   Boolean  @default(false)

  student   Student?
  employer  Employer?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id             String   @id
  firstName      String
  lastName       String
  email          String   @unique
  major          String
  graduationYear Int
  websiteUrl     String?
  resumeUrl      String?

  user           User     @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  connections    Connection[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Employer {
  id          String   @id
  companyId   String

  user        User     @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  company     Company  @relation(fields: [companyId], references: [id])
  connections Connection[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Company {
  id          String   @id @default(uuid())
  name        String
  industry    String?
  description String?
  websiteUrl  String?

  employers   Employer[]
}

model Connection {
  id         String   @id @default(uuid())
  studentId  String
  employerId String

  student    Student  @relation(fields: [studentId], references: [id], onUpdate: Cascade)
  employer   Employer @relation(fields: [employerId], references: [id], onUpdate: Cascade)

  createdAt  DateTime @default(now())

  @@unique([studentId, employerId])
  @@index([studentId])
  @@index([employerId])
}
